{
  "name": "decky-game-cheats-manager",
  "version": "1.0.0",
  "description": "Decky Loader plugin bringing Game Cheats Manager's trainer search and download to Steam Deck.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "dev": "bash scripts/dev.sh",
    "typecheck": "tsc --noEmit -p .",
    "test": "pnpm run test:frontend && pnpm run test:backend",
    "test:frontend": "node --test tests/frontend/*.test.mjs tests/tooling/*.test.mjs",
    "test:backend": "python scripts/build_gcm_core.py && python -m unittest discover -s tests -v",
    "build:gcm": "python scripts/build_gcm_core.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Qiming-Liu/Decky-Game-Cheats-Manager.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "deck",
    "trainer",
    "cheats"
  ],
  "author": "Qiming-Liu",
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/Qiming-Liu/Decky-Game-Cheats-Manager/issues"
  },
  "homepage": "https://github.com/Qiming-Liu/Decky-Game-Cheats-Manager#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "javascript-obfuscator": "4.1.1",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
